# Local datasets, generated instances, archives and reproducible reports
/data/*

# Keep source selection records; exclude images and generated instances
!/data/rescuenet_unselected/
!/data/rescuenet_unselected/**
outputs/

# Local references excluded from the instance handoff
/scripts/split_rescuenet.py
/notebooks/

# Python environments and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Interrupted atomic writes
*.part
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.cpython-*.pyc

# Large archive files (DO NOT COMMIT ZIPS > 100MB)
*.zip
*.tar.gz
*.rar
rescuenet_50x50/
rescuenet_100x100/

# Temporary office and OS files
~$*.docx
~$*.pptx
.DS_Store
Thumbs.db

# Solution outputs (can be regenerated by running runner.py)
sample_solutions/
*.solution.json

